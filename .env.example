# MySQL-compatible commerce database. TiDB Cloud Starter is the recommended free host.
# TiDB Cloud Starter public endpoints require TLS.
TIDB_HOST=your-tidb-cloud-hostname
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=deqant
TIDB_ENABLE_SSL=true

